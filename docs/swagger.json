        "/session/stream": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "description": "未传 id 时为当前用户创建临时会话，传入 id 时订阅已有会话。\n首个 init 事件的 data 为会话 ID；后续事件包含 id、event、data，event 类型为 content、reasoning、hitl 或 end。\nhitl 事件的 data 为包含 id 和 content 的 JSON 字符串；seq 用于断线重连，传入最后收到的事件序号。\n建立事件流前的错误返回 JSON；事件流开始后的错误通过关闭连接结束，不再返回 JSON。",
                "produces": [
                    "text/event-stream",
                    "application/json"
                ],
                "tags": [
                    "会话"
                ],
                "summary": "订阅会话事件流",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话 ID，不传则创建临时会话",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "default": 0,
                        "description": "最后收到的 SSE 事件序号，0 表示首次连接",
                        "name": "seq",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE 事件流",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "缺少认证 Cookie",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "500": {
                        "description": "创建、查询会话或建立事件流失败",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
